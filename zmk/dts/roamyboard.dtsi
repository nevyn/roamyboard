// VCC powers the chain. Hold it on, so that nothing can switch it off.
&{/EXT_POWER} {
    status = "disabled";
};

&gpio0 {
    vcc_on: vcc-on {
        gpio-hog;
        gpios = <13 GPIO_ACTIVE_HIGH>; // nice!nano v2: P0.13 high switches VCC on
        output-high;
    };
};

&pinctrl {
    roamyboard_chain_default: roamyboard_chain_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>;
        };
        group2 {
            psels = <NRF_PSEL(SPIM_MISO, 1, 11)>;
            bias-pull-up; // an MCU module with nothing attached reads as zero key modules
        };
    };

    roamyboard_chain_sleep: roamyboard_chain_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                <NRF_PSEL(SPIM_MISO, 1, 11)>;
            low-power-enable;
        };
    };
};

// Not spi0: the nice!view uses it, and it shares its peripheral with i2c0.
&spi1 {
    status = "okay";
    pinctrl-0 = <&roamyboard_chain_default>;
    pinctrl-1 = <&roamyboard_chain_sleep>;
    pinctrl-names = "default", "sleep";

    roamyboard_chain: kscan@0 {
        compatible = "roamyboard,kscan-165-chain";
        reg = <0>;
        spi-max-frequency = <1000000>;
        spi-cpol; // mode 2: sample on the falling edge, between the 165's rising-edge shifts
        load-gpios = <&pro_micro 18 GPIO_ACTIVE_LOW>; // D18, P1.15
        debounce-press-ms = <1>;
        debounce-release-ms = <10>;
        // columns and anchor come from each shield
    };
};
