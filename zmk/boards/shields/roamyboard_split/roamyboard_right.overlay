/*
 * Right half of a split roamyboard, the peripheral: keymap columns 15 to 29,
 * filled from the terminator module at the half's left (inner) end.
 *
 * SPDX-License-Identifier: MIT
 */

#include <roamyboard.dtsi>

&roamyboard_transform {
    col-offset = <15>;
};

&roamyboard_chain {
    columns = <15>;
    anchor = "terminator";
};
