/*
 * Right half of a split roamyboard, the peripheral: keymap columns 12 to 23,
 * filled from the terminator module at the half's left (inner) end.
 *
 * SPDX-License-Identifier: MIT
 */

#include <roamyboard.dtsi>

&roamyboard_transform {
    col-offset = <12>;
};

&roamyboard_chain {
    columns = <12>;
    anchor = "terminator";
};
