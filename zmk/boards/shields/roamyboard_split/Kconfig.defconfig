if SHIELD_ROAMYBOARD_LEFT

config ZMK_KEYBOARD_NAME
    default "roamyboard"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_ROAMYBOARD_LEFT || SHIELD_ROAMYBOARD_RIGHT

config ZMK_SPLIT
    default y

# roamyboard.dtsi holds VCC on for the chain; nothing may switch it.
config ZMK_EXT_POWER
    default n

endif
